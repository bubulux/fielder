{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fielder-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "account_id": "3868cbc17be171c90972dd32e41e7783",
  "observability": { "enabled": true },
  // Web dashboard (apps/dashboard) served as static assets from the same hostname,
  // so one Cloudflare Access session covers both UI and API.
  "assets": {
    "directory": "../dashboard/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/health"]
  },
  "vars": {
    // Cloudflare Access (Zero Trust). Not secrets: the AUD tag is public in the login redirect.
    "ACCESS_TEAM_DOMAIN": "weathered-salad-6072.cloudflareaccess.com",
    "ACCESS_AUD": "8512a955cdb50da65faefe935b15cded1660e2e47cbd4c73bd5c24dbe7d81ed4"
  },
  "r2_buckets": [
    { "binding": "SHOTS_BUCKET", "bucket_name": "fielder-shots" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fielder-db",
      "database_id": "b12cf742-e055-4f75-aa01-0cf73e36dc63",
      "migrations_dir": "migrations"
    }
  ]
}
